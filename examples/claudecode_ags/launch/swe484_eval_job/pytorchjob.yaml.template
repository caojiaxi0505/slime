# Path A SWE-bench Verified (484) eval-only PyTorchJob (1×8 GPU).
apiVersion: kubeflow.org/v1
kind: PyTorchJob
metadata:
  name: ${JOB_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    owner: jiaxicao
    workload: ${WORKLOAD}
spec:
  nprocPerNode: "8"
  pytorchReplicaSpecs:
    Master:
      replicas: 1
      restartPolicy: Never
      template:
        metadata:
          labels:
            app: cc-ags-recorder
            workload: ${WORKLOAD}
            owner: jiaxicao
        spec:
${K8S_SCHEDULING_SPEC}          nodeSelector:
            group: ${K8S_NODE_GROUP}
            node.kubernetes.io/instance-type: ml.p5e.48xlarge
            topology.kubernetes.io/zone: ap-southeast-3a
          tolerations:
            - key: glm5sft
              operator: Equal
              value: "true"
              effect: NoSchedule
${K8S_TARGET_NODE_AFFINITY}          containers:
            - name: pytorch
              image: ${IMAGE_URI}
              imagePullPolicy: Always
              command: ["bash", "-c"]
              args:
                - |
                  set -euo pipefail
                  echo "=== jiaxicao SWE484 eval (${EVAL_ROLE}) ==="
                  echo "RANK=${RANK:-} WORLD_SIZE=${WORLD_SIZE:-} MASTER_ADDR=${MASTER_ADDR:-}"
                  hostname -I
                  nvidia-smi -L
                  git config --global --add safe.directory "${SLIME_DIR}" || true
                  echo 'source /etc/profile.d/efa.sh' >> /root/.bashrc || true
                  echo 'source /etc/profile.d/zippy_efa.sh' >> /root/.bashrc || true
                  sed -i 's|cd /cfs_turbo|cd /|' ~/.bashrc || true
                  ray stop --force 2>/dev/null || true
                  cd "${SLIME_DIR}"
                  echo "=== SWE-ReX import audit ==="
                  python3 - <<'PY'
                  import os
                  import sys
                  from pathlib import Path

                  expected = Path(os.environ["SLIME_AGENT_AGS_SWE_REX_ROOT"]).resolve()
                  if not expected.is_dir():
                      raise SystemExit(f"ERROR: expected SWE-ReX root does not exist: {expected}")
                  sys.path.insert(0, str(expected))
                  import swerex

                  actual = Path(swerex.__file__).resolve()
                  try:
                      actual.relative_to(expected)
                  except ValueError:
                      raise SystemExit(
                          f"ERROR: loaded SWE-ReX from {actual}; expected it under {expected}"
                      )
                  print(f"SWE-ReX import OK: {actual}")
                  PY
                  echo "=== install pinned official SWE-bench ==="
                  python3 -m pip install \
                    --disable-pip-version-check \
                    --no-deps \
                    "swebench==${SLIME_SWEBENCH_VERSION}"
                  python3 -m pip show swebench | tee "${LOG_DIR}/swebench_package.txt"
                  echo "=== SWE484 startup audit ==="
                  python3 -m examples.claudecode_ags.swe_eval.audit preflight \
                    --dataset "${EVAL_DATA}" \
                    --report "${LOG_DIR}/startup_check.json" \
                    --required-version "${SLIME_SWEBENCH_VERSION}" \
                    --expected-tasks "${SWE_EVAL_EXPECTED_TASKS}"
                  export RUN=1
                  export PHASE=eval
                  eval_rc=0
                  bash examples/claudecode_ags/launch/run_grpo_1node_debug.sh || eval_rc=$?
                  echo "=== SWE484 artifact audit ==="
                  artifact_rc=0
                  python3 -m examples.claudecode_ags.swe_eval.audit postflight \
                    --dataset "${EVAL_DATA}" \
                    --artifact-dir "${SLIME_CC_EVAL_ARTIFACT_DIR}" \
                    --report "${LOG_DIR}/artifact_check.json" \
                    --required-version "${SLIME_SWEBENCH_VERSION}" \
                    --expected-tasks "${SWE_EVAL_EXPECTED_TASKS}" \
                    --samples-per-task "${N_SAMPLES_PER_EVAL_PROMPT}" || artifact_rc=$?
                  if [[ "${eval_rc}" != "0" || "${artifact_rc}" != "0" ]]; then
                    echo "ERROR: eval_rc=${eval_rc}, artifact_rc=${artifact_rc}" >&2
                    exit 1
                  fi
                  echo "=== SWE484 eval finished; sleeping for log inspection ==="
                  sleep 1h
              env:
                - name: SLIME_DIR
                  value: ${SLIME_DIR}
                - name: HF_CHECKPOINT
                  value: ${HF_CHECKPOINT}
                - name: REF_MODEL_PATH
                  value: ${REF_MODEL_PATH}
                - name: LOAD_PATH
                  value: ${LOAD_PATH}
                - name: LOAD_CKPT_STEP
                  value: "${LOAD_CKPT_STEP}"
                - name: SAVE_PATH
                  value: ${SAVE_PATH}
                - name: PROMPT_DATA
                  value: ${PROMPT_DATA}
                - name: EVAL_DATA
                  value: ${EVAL_DATA}
                - name: EXP_TAG
                  value: ${EXP_TAG}
                - name: LOG_DIR
                  value: ${LOG_DIR}
                - name: SLIME_AGENT_SFT_LOG_DIR
                  value: ${SLIME_AGENT_SFT_LOG_DIR}
                - name: SLIME_AGENT_SFT_LOG_INCLUDE_SESSION_ID
                  value: "1"
                - name: SLIME_AGENT_SFT_LOG_INCLUDE_TOKEN_IDS
                  value: "1"
                - name: SLIME_AGENT_SFT_LOG_INCLUDE_WIRE_REQUEST
                  value: "1"
                - name: SLIME_CC_EVAL_ARTIFACT_DIR
                  value: ${SLIME_CC_EVAL_ARTIFACT_DIR}
                - name: SLIME_SWEBENCH_VERSION
                  value: "${SLIME_SWEBENCH_VERSION}"
                - name: SWE_EVAL_EXPECTED_TASKS
                  value: "${SWE_EVAL_EXPECTED_TASKS}"
                - name: PHASE
                  value: eval
                - name: WANDB_PROJECT
                  value: ${WANDB_PROJECT}
                - name: WANDB_GROUP
                  value: ${WANDB_GROUP}
                - name: WANDB_TEAM
                  value: ${WANDB_TEAM}
                - name: SLIME_ADAPTER_PUBLIC_URL
                  value: ${SLIME_ADAPTER_PUBLIC_URL}
                - name: ANTHROPIC_BASE_URL
                  value: ${SLIME_ADAPTER_PUBLIC_URL}
                - name: SLIME_ADAPTER_PORT
                  value: "9002"
                - name: SHIM_PORT
                  value: "9002"
                - name: SHIM_BIND_HOST
                  value: "0.0.0.0"
                - name: SLIME_ADAPTER_BIND_HOST
                  value: "0.0.0.0"
                - name: ACTOR_NUM_NODES
                  value: "1"
                - name: ACTOR_NUM_GPUS_PER_NODE
                  value: "8"
                - name: ROLLOUT_NUM_GPUS
                  value: "8"
                - name: TP_SIZE
                  value: "1"
                - name: PP_SIZE
                  value: "1"
                - name: CP_SIZE
                  value: "8"
                - name: ROLLOUT_BATCH_SIZE
                  value: "16"
                - name: N_SAMPLES_PER_PROMPT
                  value: "1"
                - name: GLOBAL_BATCH_SIZE
                  value: "16"
                - name: NUM_ROLLOUT
                  value: "0"
                - name: N_SAMPLES_PER_EVAL_PROMPT
                  value: "${N_SAMPLES_PER_EVAL_PROMPT}"
                - name: MAX_CONTEXT_LEN
                  value: "${MAX_CONTEXT_LEN}"
                - name: MAX_GEN_LEN
                  value: "${MAX_GEN_LEN}"
                - name: EVAL_MAX_PROMPT_LEN
                  value: "${EVAL_MAX_PROMPT_LEN}"
                - name: ROLLOUT_MAX_CONTEXT_LEN
                  value: "${ROLLOUT_MAX_CONTEXT_LEN}"
                - name: EVAL_INTERVAL
                  value: "1"
                - name: SAVE_INTERVAL
                  value: "100"
                - name: NNODES
                  value: "1"
                - name: USE_EXTERNAL_RAY
                  value: "0"
                - name: SLIME_AGENT_SANDBOX_BACKEND
                  value: ags
                - name: SLIME_AGENT_AGS_SECRET_ID
                  valueFrom:
                    secretKeyRef:
                      name: ${AGS_SECRET_NAME}
                      key: AGS_SECRET_ID
                - name: SLIME_AGENT_AGS_SECRET_KEY
                  valueFrom:
                    secretKeyRef:
                      name: ${AGS_SECRET_NAME}
                      key: AGS_SECRET_KEY
                - name: SLIME_AGENT_AGS_TOOL_ID
                  value: ${SLIME_AGENT_AGS_TOOL_ID}
                - name: SLIME_AGENT_AGS_MOUNT_NAME
                  value: rex
                - name: SLIME_AGENT_AGS_MOUNT_IMAGE
                  value: swebenchdocker.tencentcloudcr.com/swebench/swehub:swerex-runtime
                - name: SLIME_AGENT_AGS_MOUNT_IMAGE_REGISTRY_TYPE
                  value: enterprise
                - name: SLIME_AGENT_AGS_MOUNT_PATH
                  value: /nix
                - name: SLIME_AGENT_AGS_IMAGE_SUBPATH
                  value: /nix
                - name: SLIME_AGENT_AGS_REGION
                  value: ap-guangzhou
                - name: SLIME_AGENT_AGS_DOMAIN
                  value: ap-guangzhou.tencentags.com
                - name: SLIME_AGENT_AGS_ROLE_ARN
                  value: qcs::cam::uin/100034032793:roleName/AGS_cam
                - name: SLIME_AGENT_AGS_HTTP_ENDPOINT
                  value: ags.tencentcloudapi.com
                - name: SLIME_AGENT_TOOLCHAIN_MODE
                  value: cos
                - name: SLIME_AGENT_COS_MOUNT
                  value: /mnt/code_agent
                - name: SLIME_AGENT_COS_NODE_PACKAGE
                  value: node-v20.18.1-linux-x64.tar.xz
                - name: SLIME_AGENT_COS_CC_PACKAGE
                  value: cc-prefix-2.1.104-linux-x64.tar.gz
                - name: SLIME_CC_TIME_BUDGET_SEC
                  value: "${SLIME_CC_TIME_BUDGET_SEC}"
                - name: SLIME_CC_EVAL_TIMEOUT_SEC
                  value: "${SLIME_CC_EVAL_TIMEOUT_SEC}"
                - name: SLIME_CC_GENERATE_GUARD_SEC
                  value: "${SLIME_CC_GENERATE_GUARD_SEC}"
                - name: SLIME_CC_EVAL_GUARD_SEC
                  value: "${SLIME_CC_EVAL_GUARD_SEC}"
                - name: SLIME_CC_EVAL_INFRA_RETRIES
                  value: "${SLIME_CC_EVAL_INFRA_RETRIES}"
                - name: SLIME_CC_AGENT_CONCURRENCY
                  value: "${SLIME_CC_AGENT_CONCURRENCY}"
                - name: SLIME_CC_EVAL_CONCURRENCY
                  value: "${SLIME_CC_EVAL_CONCURRENCY}"
                - name: SLIME_CC_AGENT_PROMPT
                  value: '${SLIME_CC_AGENT_PROMPT}'
                - name: SLIME_CC_INITIAL_INPUT_MODE
                  value: "${SLIME_CC_INITIAL_INPUT_MODE}"
                - name: SLIME_CC_EXTRA_ARGS_JSON
                  value: '${SLIME_CC_EXTRA_ARGS_JSON}'
                - name: ANTHROPIC_MODEL
                  value: slime-actor
                - name: ANTHROPIC_DEFAULT_SONNET_MODEL
                  value: slime-actor
                - name: ANTHROPIC_DEFAULT_OPUS_MODEL
                  value: slime-actor
                - name: ANTHROPIC_DEFAULT_HAIKU_MODEL
                  value: slime-actor
                - name: CLAUDE_CODE_SUBAGENT_MODEL
                  value: slime-actor
                - name: CLAUDE_CODE_AUTO_COMPACT_WINDOW
                  value: "${CLAUDE_CODE_AUTO_COMPACT_WINDOW}"
                - name: CLAUDE_AUTOCOMPACT_PCT_OVERRIDE
                  value: "${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE}"
                - name: CLAUDE_CODE_MAX_OUTPUT_TOKENS
                  value: "${CLAUDE_CODE_MAX_OUTPUT_TOKENS}"
                - name: CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING
                  value: "${CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING}"
                - name: CLAUDE_CODE_SKIP_PROMPT_HISTORY
                  value: "${CLAUDE_CODE_SKIP_PROMPT_HISTORY}"
                - name: CLAUDE_CODE_DISABLE_TERMINAL_TITLE
                  value: "${CLAUDE_CODE_DISABLE_TERMINAL_TITLE}"
                - name: SLIME_AGENT_AGS_TIMEOUT
                  value: "${SLIME_AGENT_AGS_TIMEOUT}"
                - name: SLIME_AGENT_AGS_RUNTIME_TIMEOUT_SEC
                  value: "${SLIME_AGENT_AGS_RUNTIME_TIMEOUT_SEC}"
                - name: SLIME_AGENT_AGS_BOOT_TIMEOUT_SEC
                  value: "${SLIME_AGENT_AGS_BOOT_TIMEOUT_SEC}"
                - name: SLIME_AGENT_AGS_SWE_REX_ROOT
                  value: ${SLIME_AGENT_AGS_SWE_REX_ROOT}
                - name: SWEREX_REQUEST_RETRIES
                  value: "0"
                - name: PATH
                  value: /root/miniconda3/envs/agent-lightning/bin:/root/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                - name: NCCL_SOCKET_IFNAME
                  value: "^lo"
                - name: FI_PROVIDER
                  value: efa
                - name: FI_EFA_USE_DEVICE_RDMA
                  value: "1"
                - name: FI_EFA_FORK_SAFE
                  value: "1"
                - name: NCCL_DEBUG
                  value: WARN
              ports:
                - containerPort: 6379
                  name: gcs-server
                - containerPort: 8265
                  name: dashboard
                - containerPort: 10001
                  name: client
                - containerPort: 8000
                  name: serve
                - containerPort: 9002
                  name: recorder
              resources:
                requests:
                  cpu: "180"
                  memory: 1800Gi
                  nvidia.com/gpu: "8"
                  vpc.amazonaws.com/efa: "32"
                limits:
                  cpu: "192"
                  memory: 2000Gi
                  nvidia.com/gpu: "8"
                  vpc.amazonaws.com/efa: "32"
              volumeMounts:
                - name: shmem
                  mountPath: /dev/shm
                - name: local
                  mountPath: /local
                - name: local-cache
                  mountPath: /root/.cache
                - name: inst-nvme
                  mountPath: /ckpt-path
                - name: preload-nvme
                  mountPath: /opt/dlami/nvme/preload
                - name: fsx-storage
                  mountPath: /mnt/sn-007
                - name: fsx-storage
                  mountPath: /mnt/fsx-c
          volumes:
            - name: shmem
              hostPath:
                path: /dev/shm
            - name: local
              hostPath:
                path: /mnt/k8s-disks/0
            - name: local-cache
              hostPath:
                path: /opt/dlami/nvme/.cache
            - name: inst-nvme
              hostPath:
                path: /opt/dlami/nvme/checkpoints/
            - name: preload-nvme
              hostPath:
                path: /opt/dlami/nvme/preload
                type: DirectoryOrCreate
            - name: fsx-storage
              persistentVolumeClaim:
                claimName: youtu-sn2-007
