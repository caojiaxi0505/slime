# Turn-level teacher SFT: internet-facing ALBs -> Service -> Master pod
#   :9002  student SGLang adapter (Stage-1)
#   :18002 teacher remote-OpenAI adapter (Stage-2)
#
# Apply via submit_alb.sh. NAME is the student Ingress/Service;
# TEACHER_NAME is the teacher Ingress (same Service, second port).
---
apiVersion: v1
kind: Service
metadata:
  name: ${NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app: cc-ags-recorder
    workload: ${WORKLOAD_LABEL}
    owner: jiaxicao
spec:
  selector:
    app: cc-ags-recorder
    workload: ${WORKLOAD_LABEL}
  ports:
    - name: student
      port: 9002
      targetPort: 9002
    - name: teacher
      port: 18002
      targetPort: 18002
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app: cc-ags-recorder
    workload: ${WORKLOAD_LABEL}
    owner: jiaxicao
    role: student-adapter
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}]'
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/healthcheck-interval-seconds: "30"
    alb.ingress.kubernetes.io/healthcheck-timeout-seconds: "10"
    alb.ingress.kubernetes.io/healthy-threshold-count: "2"
    alb.ingress.kubernetes.io/unhealthy-threshold-count: "3"
    alb.ingress.kubernetes.io/load-balancer-attributes: idle_timeout.timeout_seconds=3600
spec:
  ingressClassName: alb
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ${NAME}
                port:
                  number: 9002
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${TEACHER_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app: cc-ags-recorder
    workload: ${WORKLOAD_LABEL}
    owner: jiaxicao
    role: teacher-adapter
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}]'
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/healthcheck-interval-seconds: "30"
    alb.ingress.kubernetes.io/healthcheck-timeout-seconds: "10"
    alb.ingress.kubernetes.io/healthy-threshold-count: "2"
    alb.ingress.kubernetes.io/unhealthy-threshold-count: "3"
    alb.ingress.kubernetes.io/load-balancer-attributes: idle_timeout.timeout_seconds=3600
spec:
  ingressClassName: alb
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ${NAME}
                port:
                  number: 18002
