# Qwen3.5-9B SFT on DeepSeek-v4-pro SWE-Gym clean all-trials data.
apiVersion: kubeflow.org/v1
kind: PyTorchJob
metadata:
  name: ${JOB_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    owner: jiaxicao
    workload: ${WORKLOAD_LABEL}
spec:
  nprocPerNode: "8"
  pytorchReplicaSpecs:
    Master:
      replicas: 1
      restartPolicy: Never
      template:
        metadata:
          labels:
            workload: ${WORKLOAD_LABEL}
            owner: jiaxicao
        spec:
          nodeSelector:
            group: shennong-5
            node.kubernetes.io/instance-type: ml.p5e.48xlarge
            topology.kubernetes.io/zone: ap-southeast-3a
          tolerations:
            - key: glm5sft
              operator: Equal
              value: "true"
              effect: NoSchedule
          containers:
            - name: pytorch
              image: ${IMAGE_URI}
              imagePullPolicy: Always
              command: ["bash", "-c"]
              args:
                - |
                  set -euo pipefail
                  echo "=== jiaxicao Qwen3.5-9B SFT clean all-trials ==="
                  echo "RANK=${RANK:-} WORLD_SIZE=${WORLD_SIZE:-} MASTER_ADDR=${MASTER_ADDR:-}"
                  hostname -I
                  nvidia-smi -L
                  echo 'source /etc/profile.d/efa.sh' >> /root/.bashrc || true
                  echo 'source /etc/profile.d/zippy_efa.sh' >> /root/.bashrc || true
                  sed -i 's|cd /cfs_turbo|cd /|' ~/.bashrc || true
                  cd "${SLIME_DIR}"
                  bash examples/claudecode_ags/launch/sft_qwen35_9b_clean_all/run_sft.sh
                  echo "=== SFT finished; sleeping for log inspection ==="
                  sleep 1h
              env:
                - name: SLIME_DIR
                  value: ${SLIME_DIR}
                - name: HF_CHECKPOINT
                  value: ${HF_CHECKPOINT}
                - name: REF_MODEL_PATH
                  value: ${REF_MODEL_PATH}
                - name: PROMPT_DATA
                  value: ${PROMPT_DATA}
                - name: EXP_TAG
                  value: ${EXP_TAG}
                - name: LOG_DIR
                  value: ${LOG_DIR}
                - name: LOAD_PATH
                  value: ${LOAD_PATH}
                - name: SAVE_PATH
                  value: ${SAVE_PATH}
                - name: NUM_EPOCH
                  value: "${NUM_EPOCH}"
                - name: ROLLOUT_BATCH_SIZE
                  value: "${ROLLOUT_BATCH_SIZE}"
                - name: GLOBAL_BATCH_SIZE
                  value: "${GLOBAL_BATCH_SIZE}"
                - name: SAVE_INTERVAL
                  value: "${SAVE_INTERVAL}"
                - name: MAX_CONTEXT_LEN
                  value: "${MAX_CONTEXT_LEN}"
                - name: ROLLOUT_MAX_PROMPT_LEN
                  value: "${ROLLOUT_MAX_PROMPT_LEN}"
                - name: MAX_TOKENS_PER_GPU
                  value: "${MAX_TOKENS_PER_GPU}"
                - name: WANDB_KEY
                  value: ${WANDB_KEY}
                - name: WANDB_PROJECT
                  value: ${WANDB_PROJECT}
                - name: WANDB_GROUP
                  value: ${WANDB_GROUP}
                - name: WANDB_TEAM
                  value: ${WANDB_TEAM}
                - name: PATH
                  value: /root/miniconda3/envs/agent-lightning/bin:/root/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                - name: NCCL_SOCKET_IFNAME
                  value: "^lo"
                - name: FI_PROVIDER
                  value: efa
                - name: FI_EFA_USE_DEVICE_RDMA
                  value: "1"
                - name: FI_EFA_FORK_SAFE
                  value: "1"
                - name: NCCL_DEBUG
                  value: WARN
              ports:
                - containerPort: 6379
                  name: gcs-server
                - containerPort: 8265
                  name: dashboard
                - containerPort: 10001
                  name: client
              resources:
                requests:
                  cpu: "180"
                  memory: 1800Gi
                  nvidia.com/gpu: "8"
                  vpc.amazonaws.com/efa: "32"
                limits:
                  cpu: "192"
                  memory: 2000Gi
                  nvidia.com/gpu: "8"
                  vpc.amazonaws.com/efa: "32"
              volumeMounts:
                - name: shmem
                  mountPath: /dev/shm
                - name: local
                  mountPath: /local
                - name: local-cache
                  mountPath: /root/.cache
                - name: inst-nvme
                  mountPath: /ckpt-path
                - name: preload-nvme
                  mountPath: /opt/dlami/nvme/preload
                - name: fsx-storage
                  mountPath: /mnt/sn-007
                - name: fsx-storage
                  mountPath: /mnt/fsx-c
          volumes:
            - name: shmem
              hostPath:
                path: /dev/shm
            - name: local
              hostPath:
                path: /mnt/k8s-disks/0
            - name: local-cache
              hostPath:
                path: /opt/dlami/nvme/.cache
            - name: inst-nvme
              hostPath:
                path: /opt/dlami/nvme/checkpoints/
            - name: preload-nvme
              hostPath:
                path: /opt/dlami/nvme/preload
                type: DirectoryOrCreate
            - name: fsx-storage
              persistentVolumeClaim:
                claimName: youtu-sn2-007

