# Slime + AGS pipeline knobs (SLIME_* only).
# Copy to slime_ags.env and fill in real values before training:
#   cp examples/claudecode_ags/env/slime_ags.env.example examples/claudecode_ags/env/slime_ags.env
#
# Secrets: prefer K8s secretKeyRef (SLIME_AGENT_AGS_SECRET_ID/KEY) or a local
# SLIME_AGENT_AGS_ENV_FILE. Do not commit slime_ags.env or credential files.
# Do NOT set SLIME_AGENT_AGS_ENV_FILE to a placeholder path — load_env.sh will
# unset a missing file, but Ray may still see a bad value if you export it.
#
# Job/operator exports are preserved by load_env.sh over this file (TIMEOUT,
# ADAPTER_PORT, MOUNT_*, TOOL_ID, etc.). See TROUBLESHOOTING.md.

# --- Sandbox backend ---
SLIME_AGENT_SANDBOX_BACKEND=ags

# --- Tencent AGS (required unless loaded via SLIME_AGENT_AGS_ENV_FILE) ---
# SLIME_AGENT_AGS_ENV_FILE=/path/to/ags_secrets.conf
# SLIME_AGENT_AGS_SECRET_ID=
# SLIME_AGENT_AGS_SECRET_KEY=
SLIME_AGENT_AGS_TOOL_ID=sdt-exb9o2gb
SLIME_AGENT_AGS_REGION=ap-guangzhou
SLIME_AGENT_AGS_DOMAIN=ap-guangzhou.tencentags.com
SLIME_AGENT_AGS_ROLE_ARN=qcs::cam::uin/100034032793:roleName/AGS_cam
SLIME_AGENT_AGS_HTTP_ENDPOINT=ags.tencentcloudapi.com

# --- AGS optional sizing / timeouts ---
# Lease length for StartSandboxInstance. Cluster Job uses 45m; if load_env
# fails to preserve Job env, example 30m will overwrite and long rollouts
# get /execute 404 after ~30min. Keep Job value via load_env preserve list.
SLIME_AGENT_AGS_CPU=2
SLIME_AGENT_AGS_MEMORY=4Gi
SLIME_AGENT_AGS_TIMEOUT=45m
SLIME_AGENT_AGS_BOOT_TIMEOUT_SEC=600
SLIME_AGENT_AGS_RUNTIME_TIMEOUT_SEC=2700
SLIME_AGENT_AGS_PORT=8000
SLIME_AGENT_AGS_IMAGE_REGISTRY_TYPE=enterprise

# --- AGS StorageMount: swerex-runtime (recommended for stable sandbox boot) ---
# Without this: FailedOperation.ContainerStart / "port binding failed".
# See TROUBLESHOOTING.md.
SLIME_AGENT_AGS_MOUNT_NAME=rex
SLIME_AGENT_AGS_MOUNT_IMAGE=swebenchdocker.tencentcloudcr.com/swebench/swehub:swerex-runtime
SLIME_AGENT_AGS_MOUNT_IMAGE_REGISTRY_TYPE=enterprise
SLIME_AGENT_AGS_MOUNT_PATH=/nix
SLIME_AGENT_AGS_IMAGE_SUBPATH=/nix

# Path to SWE-ReX src/ when not installed as a package (leave unset if packaged).
# SLIME_AGENT_AGS_SWE_REX_ROOT=

# --- Toolchain install inside sandbox ---
# skip | tarball | cos (cos = untar from AGS-mounted COS dir)
SLIME_AGENT_TOOLCHAIN_MODE=cos
SLIME_AGENT_COS_MOUNT=/mnt/code_agent
SLIME_AGENT_COS_NODE_PACKAGE=node-v20.18.1-linux-x64.tar.xz
SLIME_AGENT_COS_CC_PACKAGE=cc-prefix-2.1.104-linux-x64.tar.gz
SLIME_AGENT_COS_NODE_DIR=/opt/node-cos
SLIME_AGENT_COS_CC_DIR=/opt/cc-cos
# tarball mode (host paths readable by sandbox write_file):
# SLIME_AGENT_TOOLCHAIN_MODE=tarball
# SLIME_AGENT_NODE_TARBALL=/path/to/node-v22.x-linux-x64.tar.xz
# SLIME_AGENT_CC_TARBALL=/path/to/anthropic-ai-claude-code-local-linux-x64.tgz

# --- HTTP adapter (CC in sandbox → adapter → SGLang) ---
# Cluster Job + ALB use port 9002 (Service/Ingress targetPort).
# Job-injected SLIME_ADAPTER_PORT is preserved by load_env.sh — do not let
# an old 18001 default overwrite it (ALB 502 / adapter_session_empty).
SLIME_ADAPTER_PUBLIC_URL=http://10.0.0.1:9002
SLIME_ADAPTER_BIND_HOST=0.0.0.0
SLIME_ADAPTER_PORT=9002
SHIM_PORT=9002

# --- Per-sample time budgets (seconds) ---
SLIME_CC_TIME_BUDGET_SEC=1800
SLIME_CC_EVAL_TIMEOUT_SEC=600
SLIME_CC_GENERATE_GUARD_SEC=2700
SLIME_CC_AGENT_CONCURRENCY=32
SLIME_CC_EVAL_CONCURRENCY=64
# Gate only AGS sandbox startup; sandbox execution can still be more concurrent.
SLIME_AGENT_AGS_START_CONCURRENCY=16
SLIME_AGENT_AGS_THREADPOOL_WORKERS=16

# --- Rollout sampling (optional overrides for launch scripts) ---
# SLIME_CC_TRAIN_TEMPERATURE=1.0
# SLIME_CC_TRAIN_TOP_P=1.0
# SLIME_CC_TRAIN_TOP_K=-1
# SLIME_CC_TRAIN_N_SAMPLES_PER_PROMPT=8
# SLIME_CC_EVAL_TEMPERATURE=0.6
# SLIME_CC_EVAL_TOP_P=0.95
# SLIME_CC_EVAL_TOP_K=20
# SLIME_CC_EVAL_N_SAMPLES_PER_PROMPT=1

# --- SWE eval → resolved thresholds (used by swe_eval / custom reward plugins) ---
SLIME_CC_REWARD_F2P_THRESHOLD=1.0
SLIME_CC_REWARD_P2P_THRESHOLD=0.99

# --- Remote teacher (OpenAI-compatible). Adapter posts to $BASE_URL/v1/chat/completions ---
# Models list: $BASE_URL/v1/models
# SLIME_REMOTE_OPENAI_BASE_URL=https://ms-9hcl5fm5-100034032793-sw.gw.ap-zhongwei.ti.tencentcs.com/ms-9hcl5fm5
SLIME_REMOTE_OPENAI_BASE_URL=https://ms-bg7s6hs9-100034032793-sw.gw.ap-zhongwei.ti.tencentcs.com/ms-bg7s6hs9
# SLIME_REMOTE_OPENAI_MODEL=original_maas/deepseek-v4-pro
SLIME_REMOTE_OPENAI_MODEL=DeepSeek-V4-Flash-0731
# SLIME_REMOTE_OPENAI_API_KEY=
# DeepSeek-v4-pro: HTTP body needs both thinking.type and reasoning_effort.
SLIME_REMOTE_OPENAI_THINKING_TYPE=enabled
SLIME_REMOTE_OPENAI_REASONING_EFFORT=max
SLIME_REMOTE_OPENAI_MAX_INFLIGHT=64
SLIME_REMOTE_OPENAI_CONNECTOR_LIMIT=128
# Optional four-request keepalive batch while Stage-1 has no teacher traffic.
# Set KEEPALIVE_SEC=0 to disable.
SLIME_REMOTE_OPENAI_KEEPALIVE_SEC=60
SLIME_REMOTE_OPENAI_KEEPALIVE_MAX_TOKENS=1
SLIME_REMOTE_OPENAI_KEEPALIVE_INFLIGHT=4

# --- Teacher Anthropic shim (Stage-2). Cluster jobs override PUBLIC_URL via ALB. ---
# SLIME_TEACHER_ADAPTER_BIND_HOST=0.0.0.0
# SLIME_TEACHER_ADAPTER_PORT=18002
# SLIME_TEACHER_ADAPTER_PUBLIC_URL=
# Keep student and remote-Teacher request logs in different directories.
# SLIME_AGENT_SFT_LOG_DIR=/path/to/run/student_sft_turns
# SLIME_TEACHER_SFT_LOG_DIR=/path/to/run/teacher_sft_turns
