# Slime + AGS pipeline knobs (SLIME_* only).
# Copy to slime_ags.env and fill in real values before training:
#   cp examples/claudecode_ags/env/slime_ags.env.example examples/claudecode_ags/env/slime_ags.env
#
# Secrets: prefer SLIME_AGENT_AGS_ENV_FILE pointing at a local KEY=VALUE file
# (e.g. ~/.cos_ags.conf). Do not commit slime_ags.env or credential files.

# --- Sandbox backend ---
SLIME_AGENT_SANDBOX_BACKEND=ags

# --- Tencent AGS (required unless loaded via SLIME_AGENT_AGS_ENV_FILE) ---
SLIME_AGENT_AGS_ENV_FILE=/path/to/your/ags_secrets.conf
# SLIME_AGENT_AGS_SECRET_ID=your-secret-id
# SLIME_AGENT_AGS_SECRET_KEY=your-secret-key
SLIME_AGENT_AGS_TOOL_ID=your-tool-id
SLIME_AGENT_AGS_REGION=ap-guangzhou
SLIME_AGENT_AGS_DOMAIN=ags.tencentcloudapi.com
SLIME_AGENT_AGS_ROLE_ARN=acs:ags:xxx:tool/xxx
SLIME_AGENT_AGS_HTTP_ENDPOINT=https://ags.example.com

# --- AGS optional sizing / timeouts ---
SLIME_AGENT_AGS_CPU=2
SLIME_AGENT_AGS_MEMORY=4Gi
SLIME_AGENT_AGS_TIMEOUT=30m
SLIME_AGENT_AGS_BOOT_TIMEOUT_SEC=600
SLIME_AGENT_AGS_RUNTIME_TIMEOUT_SEC=600
SLIME_AGENT_AGS_PORT=8000
SLIME_AGENT_AGS_IMAGE_REGISTRY_TYPE=enterprise

# --- AGS optional mount (leave SLIME_AGENT_AGS_MOUNT_NAME empty to skip) ---
# SLIME_AGENT_AGS_MOUNT_NAME=
# SLIME_AGENT_AGS_MOUNT_IMAGE=
# SLIME_AGENT_AGS_MOUNT_IMAGE_REGISTRY_TYPE=enterprise
# SLIME_AGENT_AGS_MOUNT_PATH=/nix
# SLIME_AGENT_AGS_IMAGE_SUBPATH=/nix

# Path to SWE-ReX src/ when not installed as a package.
SLIME_AGENT_AGS_SWE_REX_ROOT=/path/to/swerex/src

# --- Toolchain install inside sandbox ---
# skip | tarball (COS-based install via SLIME_AGENT_COS_* is not implemented yet)
SLIME_AGENT_TOOLCHAIN_MODE=tarball
SLIME_AGENT_NODE_TARBALL=/path/to/node-v22.x-linux-x64.tar.xz
SLIME_AGENT_CC_TARBALL=/path/to/anthropic-ai-claude-code-local-linux-x64.tgz

# Optional COS placeholders (future; not wired in agent_runtime yet):
# SLIME_AGENT_COS_SECRET_ID=
# SLIME_AGENT_COS_SECRET_KEY=
# SLIME_AGENT_COS_REGION=
# SLIME_AGENT_COS_BUCKET=
# SLIME_AGENT_COS_NODE_KEY=
# SLIME_AGENT_COS_CC_KEY=

# --- HTTP adapter (CC in sandbox → adapter → SGLang) ---
# SLIME_ADAPTER_PUBLIC_URL must be routable from inside the AGS sandbox (not 127.0.0.1).
SLIME_ADAPTER_PUBLIC_URL=http://10.0.0.1:18001
SLIME_ADAPTER_BIND_HOST=0.0.0.0
SLIME_ADAPTER_PORT=18001

# --- Per-sample time budgets (seconds) ---
SLIME_CC_TIME_BUDGET_SEC=1800
SLIME_CC_EVAL_TIMEOUT_SEC=600
SLIME_CC_GENERATE_GUARD_SEC=0

# --- Rollout sampling (optional overrides for launch scripts) ---
# SLIME_CC_TRAIN_TEMPERATURE=1.0
# SLIME_CC_TRAIN_TOP_P=1.0
# SLIME_CC_TRAIN_TOP_K=-1
# SLIME_CC_TRAIN_N_SAMPLES_PER_PROMPT=8
# SLIME_CC_EVAL_TEMPERATURE=0.6
# SLIME_CC_EVAL_TOP_P=0.95
# SLIME_CC_EVAL_TOP_K=20
# SLIME_CC_EVAL_N_SAMPLES_PER_PROMPT=1

# --- SWE eval → resolved thresholds (used by swe_eval / custom reward plugins) ---
SLIME_CC_REWARD_F2P_THRESHOLD=1.0
SLIME_CC_REWARD_P2P_THRESHOLD=0.99
