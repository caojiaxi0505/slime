# Claude Code / Anthropic / Bash knobs only (official env var names).
# Sourced by load_env.sh and passed through to the sandbox `claude` process.
# See: https://code.claude.com/docs/en/env-vars

# Autocompact: keep below rollout hard context; tune with ROLLOUT_MAX_CONTEXT_LEN.
CLAUDE_CODE_AUTO_COMPACT_WINDOW=101000
CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=95

# Cap per-turn model and tool output so compaction is not immediately undone.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384
CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=16000
BASH_MAX_OUTPUT_LENGTH=65536
TASK_MAX_OUTPUT_LENGTH=32000
MAX_MCP_OUTPUT_TOKENS=25000
MAX_THINKING_TOKENS=0

# SWE-bench tests can run longer than Claude Code defaults.
BASH_DEFAULT_TIMEOUT_MS=300000
BASH_MAX_TIMEOUT_MS=900000

# Gateway / offline adapter: avoid stream idle watchdogs during long SGLang prefills.
API_TIMEOUT_MS=1200000
API_FORCE_IDLE_TIMEOUT=0
CLAUDE_STREAM_IDLE_TIMEOUT_MS=1200000
CLAUDE_ENABLE_STREAM_WATCHDOG=0
CLAUDE_ENABLE_BYTE_WATCHDOG=0

# Optional Claude Code behavior toggles (uncomment to override defaults).
# CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1
# CLAUDE_CODE_DISABLE_THINKING=0
# CLAUDE_CODE_SKIP_PROMPT_HISTORY=1
# CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
# CLAUDE_CODE_MAX_RETRIES=3
# CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS=0
# ANTHROPIC_CUSTOM_HEADERS=
